{
  "name": "project-steward-marketplace",
  "description": "Marketplace exposing the Project Steward plugin to Codex (`codex plugin marketplace add <path-or-repo>`).",
  "interface": {
    "displayName": "Project Steward"
  },
  "plugins": [
    {
      "name": "project-steward",
      "source": {
        "source": "local",
        "path": "./plugins/project-steward"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Productivity"
    }
  ]
}
