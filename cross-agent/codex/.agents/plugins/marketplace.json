{
  "name": "cross-agent-marketplace",
  "description": "Marketplace exposing the cross-agent plugin to Codex (`codex plugin marketplace add <path-or-repo>`).",
  "interface": {
    "displayName": "cross-agent"
  },
  "plugins": [
    {
      "name": "cross-agent",
      "source": {
        "source": "local",
        "path": "./plugins/cross-agent"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
